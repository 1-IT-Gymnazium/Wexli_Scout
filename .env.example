# Supabase projekt. Skutečné hodnoty patří do .env.local, nikdy do gitu ani do chatu.
# URL: Project Settings → Data API (nebo tlačítko Copy u adresy na přehledu projektu)
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys: "Publishable key" (sb_publishable_…), starší projekty "anon"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project Settings → API Keys: "Secret key" (sb_secret_…), starší projekty "service_role". Jen pro server.
SUPABASE_SECRET_KEY=
